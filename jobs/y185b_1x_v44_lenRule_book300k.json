      "script": "run/r42.js",
      "args": [
        "deepURSx3",
        "{\"env\":\"seq\",\"params\":{\"source\":\"book\",\"nSyms\":100000,\"evalSyms\":2000}}",
        "1",
        "pl.lr@cortex=0.2,P.granN=8000,P.granKmin=3,P.granK=4,P.granW=60,P.fastEngine=1",
        "2536",
        "--force"
      ],
      "label": "v44 1x book100k g2536 n1",
