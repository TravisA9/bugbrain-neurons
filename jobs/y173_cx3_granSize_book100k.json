  "slotHours": 7.5,
  "phone": false,
  "flag": "text",
  "memGB": 3.5,
  "accept": {
    "note": "y151: cx3 v41 book100k 0.391 (+0.024 over v41 1x) but flat with length like 1x. Does a granule layer sized with the cortex lift the 100k level further?"
  },
  "runs": [
    {
      "script": "run/r42.js",
      "args": [
        "deepURSx3",
        "{\"env\":\"seq\",\"params\":{\"source\":\"book\",\"nSyms\":100000,\"evalSyms\":2000}}",
        "1",
        "sc.sizeF@cortex=3,sc.divRep@cortex=2,sc.trophMin@cortex=0.001667,P.fanRef=450,P.fanRefR=126,pl.lr@cortex=0.2,pl.preNorm@cortex=45,P.granN=2000,P.granRef=600,P.fastEngine=1",
        "1400",
        "--force"
      ],
      "label": "v42 cx3 book100k g1400 n1",
      "env": {
        "BB_OUT": "results/phone/y173_cx3_granSize_book100k.jsonl"
