  "title": "demand-grown claws, recycle on vs off, at granN 8000: book10k, book30k, fables4000, text1000, fresh k 2800-2807",
  "priority": 0.9,
  "estHours": 0.4,
  "slotHours": 2.6,
  "phone": false,
  "flag": "text",
  "memGB": 1.5,
  "accept": {
    "note": "Hypothesis: demand-grown claws from repeated co-occurrence vs random sparse claws at the same N. Do NOT adopt from this job. v44 / DEFAULTS_VERSION 37 stay. Read it with the 16-growth rule (no task worse: losses not > 60%, t > -2) only together with granAsg near 8000 (matched final cell count). granAsg / granRec / granPend are in the r42 stats. Same co-occurrence threshold (2). granRecycle=0 stops at the cap; granRecycle=1 rewrites the least-used granule. granAsg should match across the two demand arms when the pool fills; granRec says whether later patterns replaced early ones."
  },
  "runs": [
    {
      "script": "run/r42.js",
      "args": [
        "deepURSx3",
        "{\"env\":\"seq\",\"params\":{\"source\":\"book\",\"nSyms\":10000,\"evalSyms\":2000}}",
        "1",
        "pl.lr@cortex=0.2,P.granN=8000,P.granKmin=3,P.granK=4,P.granW=60,P.fastEngine=1",
        "2800",
        "--force"
