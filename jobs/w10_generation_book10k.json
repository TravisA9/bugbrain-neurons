  "title": "Free-running generation (run/gen.js): after a book 10k life, learning frozen, 500 self-fed symbols; v35 argmax / sampled (genTemp 1), predErr 0.1 sampled; growths 0-3",
  "priority": 0.96,
  "estHours": 0.25,
  "phone": false,
  "flag": "text",
  "accept": {
    "note": "baseline sample quality (word rate, copy rate, trigram bits vs real text) for later size / rule comparisons"
  },
  "runs": [
    {
      "script": "run/gen.js",
      "args": [
        "deepURSx3",
        "{\"env\":\"seq\",\"params\":{\"source\":\"book\",\"nSyms\":10000,\"evalSyms\":2000,\"genSyms\":500,\"genTemp\":0}}",
        "4",
        "pl.predErr=0.3,pl.peMode=16,pl.peFix=0.01",
        "0"
      ],
      "label": "deepURSx3 book10k gen500 T0 v35 g0 n4",
      "env": {
        "BB_OUT": "results/phone/w10_generation_book10k.jsonl"
      }
    },
    {
      "script": "run/gen.js",
      "args": [
        "deepURSx3",
